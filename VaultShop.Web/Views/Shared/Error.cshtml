@model ErrorViewModel
@{
    ViewData["Title"] = Model.Title ?? "Error";
}

<section class="py-5 text-center">
    <h1 class="display-4 fw-bold">@(Model.StatusCode?.ToString() ?? "")</h1>
    <h2 class="text-danger">@(Model.Title ?? "Error")</h2>
    <p class="lead">@(Model.Message ?? "")</p>
    <a class="btn btn-primary mt-3" asp-area="Customer" asp-controller="Home" asp-action="Index">@Localizer["BackHome"]</a>
    @if (Model.ShowRequestId)
    {
        <p class="mt-4"><small><strong>@Localizer["RequestId"]:</strong> <code>@Model.RequestId</code></small></p>
    }
</section>
